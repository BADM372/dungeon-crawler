title    Overworld
about    A heroic quick march for band. Level 1 voices join when an enemy is near, level 2 while fighting.
tempo    120
beats    4
steps    4
reverb   0.3

# the game fades voices in by intensity: unlisted voices are level 0 (exploring)
# level 1: pulse timpani tenors_hi tenors_mid tenors_lo
# level 2: kick2 cymbal snare2 brass horn

voice lead       trumpet   vol=1 pan=0.1
voice harmony    clarinet  vol=0.56 pan=-0.3
voice chords     brass     vol=0.56 pan=0.25 gate=0.9
voice bass       tuba      vol=0.72
voice bells      glock     vol=0.72 pan=0.4
voice snare      snare     vol=0.8 pan=0.21
voice bassdrum   kick      vol=0.8 pan=0.21
voice pulse      strings   vol=0.72 pan=-0.44 att=0.03 rel=0.1
voice timpani    timpani   vol=0.64 pan=-0.14
voice tenors_hi  tomhi     vol=0.36 pan=0.35
voice tenors_mid tommid    vol=0.36 pan=0.35
voice tenors_lo  tomlo     vol=0.36 pan=0.35
voice kick2      kick      vol=0.8 pan=0.21
voice cymbal     crash     vol=0.8 pan=0.21
voice snare2     snare     vol=0.8 pan=0.21
voice brass      brass     vol=0.42 pan=-0.21
voice horn       horn      vol=0.49 pan=0.3

