# Before writing or changing music, read music/README.md (style, layers, format).
title    Caves
about    A dark, driving cave theme in 5/4. More drums join when an enemy is near, brass and kit in a fight.
tempo    76
beats    5
steps    4
reverb   0.5

# moods (music/README.md); rise falls back to sense, treasure to explore, boss to fight
# mood explore: lead pad bass drops drops2 tom_lo tom_mid tom_hi
# mood sense:   explore tremolo timpani taiko_lo taiko_hi taiko_mid shaker
# mood fight:   sense kick snare hat crash brass strings

voice lead      flute     vol=0.9 pan=0.15
voice pad       strings   vol=0.49 pan=-0.2 att=0.6 rel=0.8
voice bass      fretless  vol=0.81
voice drops     musicbox  vol=0.56 pan=0.5 rev=0.7
voice drops2    musicbox  vol=0.56 pan=0.5 rev=0.7
voice tom_lo    tomlo     vol=0.8 pan=-0.1
voice tom_mid   tommid    vol=0.8 pan=-0.1
voice tom_hi    tomhi     vol=0.8 pan=-0.1
voice tremolo   strings   vol=0.36 pan=-0.4 att=0.2
voice timpani   timpani   vol=0.64 pan=-0.15
voice taiko_lo  tomlo     vol=0.36 pan=0.35
voice taiko_hi  tomhi     vol=0.36 pan=0.35
voice taiko_mid tommid    vol=0.36 pan=0.35
voice shaker    shaker    vol=0.8 pan=-0.1
voice kick      kick      vol=0.8 pan=-0.1
voice snare     snare     vol=0.8 pan=-0.1
voice hat       hat       vol=0.8 pan=-0.1
voice crash     crash     vol=0.8 pan=-0.1
voice brass     brass     vol=0.36 pan=-0.25
voice strings   strings   vol=0.42 pan=0.3

