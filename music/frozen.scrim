rim     | % | % | % | x.o.x.o.xxxx |
tri     | x.......o... | % | % | % |
tri     | % | % | % | x...x...x... |
kick    | X.......x... | % | % | % |
kick    | % | % | % | X...X...X.X. |
snare   | ....x...o... | % | % | % |
snare   | % | % | % | ....x.x.xxxx |
crash   | X........... | ............ | % | % |
crash   | x........... | ............ | % | % |
choir   | [F#m]----------- | [D]----------- | [Bm]----------- | [C#]----------- |
choir   | [F#m]----------- | [D]----------- | [E]----------- | [C#]----------- |
bell    | F#4----------- | D4----------- | B3----------- | C#4----------- |
bell    | F#4----------- | D4----------- | E4----------- | C#4----------- |

# Bm F#m D E | Bm F#m G C#
pattern B
lead    | D5------- C#5--- | C#5------- A4--- | F#5------- E5- D5- | E5----------- |
lead    | D5--- C#5--- B4--- | A4------- F#4--- | B4------- D5--- | E#4----------- |
echo    | .-- D5------- C#5 | --- C#5------- A4 | --- F#5------- E5 | - D5- E5-------- |
echo    | --- D5--- C#5--- B4 | --- A4------- F#4 | --- B4------- D5 | --- E#4-------- |
horn    | D5------- C#5--- | C#5------- A4--- | F#5------- E5- D5- | E5----------- |
