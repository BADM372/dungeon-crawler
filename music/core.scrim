# Before writing or changing music, read music/README.md (style, moods, format).
title    Core
composer Claude
about    The bottom of the world: the overworld's flute tune come back in E minor, slow and heavy, over harp, strings, a low organ fifth, tuba and a bell; the Neapolitan F in the second half darkens it further. When something is near, timpani and toms take over; horn and brass carry the last fight, and choir and gong the last guardian.
tempo    70
beats    4
steps    4
reverb   0.55

# moods (music/README.md)
# mood explore:  lead harp strings organ tuba bell
# mood treasure: harp strings bell wonder
# mood sense:    timpani toms tuba strings organ
# mood rise:     sense lead harp kick snare
# mood fight:    rise -harp horn brass crash
# mood boss:     fight -lead choir gong

voice lead     flute     vol=0.65 pan=-0.1 rev=0.5
voice horn     horn      vol=0.7  pan=0.2  oct=-1
voice harp     harp      vol=0.5  pan=0.3
voice strings  strings   vol=0.26 pan=-0.25 center=B3 att=0.5 rel=0.8
voice organ    pipe      vol=0.25 att=0.4 rel=1
voice tuba     tuba      vol=0.65 gate=0.9
voice bell     bell      vol=0.2  pan=0.4  rev=0.7
voice wonder   celesta   vol=0.35 pan=-0.35 rev=0.6
voice timpani  timpani   vol=0.6  pan=-0.1
voice toms     tomlo     vol=0.5  pan=-0.2
voice kick     kick      vol=0.55
voice snare    snare     vol=0.4  pan=0.1
voice brass    brass     vol=0.4  pan=-0.25 gate=0.8 center=B3
voice crash    crash     vol=0.24 pan=0.2
voice choir    choir     vol=0.34 center=E4 att=0.4 rel=0.8
voice gong     gong      vol=0.35 pan=-0.3

